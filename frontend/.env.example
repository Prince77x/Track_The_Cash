# Leaflet Map Tile Configuration (Optional)
# Standard OpenStreetMap and CARTO Basemaps do NOT require any API key (100% Free).

# If you want to use Mapbox Dark tiles:
# VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0...

# If you want to use a custom tile server URL (e.g. Stadia Maps, Jawg, or self-hosted tile server):
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=YOUR_API_KEY
